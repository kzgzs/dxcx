APP_DEBUG = true # 调试开关，生产环境务必改为 false
JWT_SECRET = change-me # JWT 签名密钥，部署前必须更换

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai
DEFAULT_APP = console # 默认应用

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = database_name
USERNAME = username
PASSWORD = password
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX =

[REDIS]
HOST = 127.0.0.1
PORT = 6379
PASSWORD =
SELECT = 0

[SESSION]
TYPE = file # 会话驱动：file / cache（纯 API 场景一般用不到）

[QUEUE]
TYPE = redis # 队列默认连接：redis / sync / database

[LANG]
default_lang = zh-cn

[OPEN_PLATFORM]
MOCK = 0 # 开放平台mock开关（无资质模拟闭环，生产必须置 0）
